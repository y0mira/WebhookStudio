{
  "WebhookStudio": {
    "MaxBodyBytes": 1048576,
    "DefaultRetentionLimit": 500,
    "MaxHeaderCount": 100,
    "MaxHeaderValueLength": 8192,
    "MaxPathLength": 4096,
    "AllowPrivateNetworkReplay": false,
    "MaxReplayRedirects": 5,
    "ReplayTimeoutSeconds": 15,
    "MaxReplayResponseBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
